@page "/login"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject AuthApiService AuthApi
@inject NavigationManager Nav

<PageTitle>Portal de Acceso · BiblioTech</PageTitle>

<div class="row justify-content-center align-items-center" style="min-height: 72vh;">
    <div class="col-sm-11 col-md-7 col-lg-5 col-xl-4">
        <div class="card login-box border-0 shadow-lg">
            <div class="card-body p-4 p-sm-5 text-center">
                <!-- Insignia y Marca de la Biblioteca -->
                <div class="login-crest mb-2">📚</div>
                <h1 class="h3 fw-bold mb-1" style="font-family: var(--biblio-font-heading); letter-spacing: 0.05em; color: var(--biblio-ink-dark);">
                    BiblioTech
                </h1>
                <p class="text-uppercase fw-semibold mb-4" style="font-size: 0.72rem; letter-spacing: 0.16em; color: var(--biblio-wood);">
                    Portal del Bibliotecario
                </p>

                <div class="text-start">
                    <Alerta Mensaje="@error" Tipo="danger" OnCerrar="() => error = null" />

                    @* Formulario con validación automática de DataAnnotations *@
                    <EditForm Model="modelo" OnValidSubmit="IngresarAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label" for="email">
                                <span class="me-1">✉️</span> Correo institucional
                            </label>
                            <InputText id="email" class="form-control form-control-lg fs-6" 
                                       placeholder="bibliotecario@bibliotech.edu" 
                                       @bind-Value="modelo.Email" 
                                       autocomplete="username" />
                            <ValidationMessage For="() => modelo.Email" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label" for="password">
                                <span class="me-1">🔑</span> Clave de seguridad
                            </label>
                            <InputText id="password" type="password" 
                                       class="form-control form-control-lg fs-6" 
                                       placeholder="••••••••" 
                                       @bind-Value="modelo.Password" 
                                       autocomplete="current-password" />
                            <ValidationMessage For="() => modelo.Password" />
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fs-6 py-2 shadow-sm" disabled="@enviando">
                            @(enviando ? "Verificando credenciales..." : "Acceder al Mostrador 📖")
                        </button>
                    </EditForm>
                </div>

                <div class="mt-4 pt-3 border-top" style="border-color: var(--biblio-border-subtle) !important;">
                    <small class="text-muted" style="font-size: 0.75rem;">
                        Sistema de Circulación, Acervo y Gestión Bibliográfica
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly LoginDto modelo = new();
    private string? error;
    private bool enviando;

    private async Task IngresarAsync()
    {
        enviando = true;
        error = null;
        try
        {
            await AuthApi.IniciarSesionAsync(modelo);
            Nav.NavigateTo("");   // al inicio (dashboard)
        }
        catch (ApiException ex)
        {
            error = ex.Message;   // ej. "Correo o contraseña incorrectos." (401 de la API)
        }
        finally
        {
            enviando = false;
        }
    }
}
